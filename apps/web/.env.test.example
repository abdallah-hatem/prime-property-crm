# Playwright settings (copy to apps/web/.env.test or export them). No ports are hardcoded in config.
# Playwright starts `next dev` on WEB_PORT (a parallel agent uses its block: web 31N3)
WEB_PORT=3010
# Optional: the API the dev server talks to (NEXT_PUBLIC_API_URL=http://localhost:$API_PORT/api)
# API_PORT=4010
# Optional: test a server that is already running (preview, production) instead of starting one
# BASE_URL=https://<preview>.vercel.app
# VERCEL_AUTOMATION_BYPASS_SECRET=
# Seeded account passwords (the values apps/api/.env gave the seed). Never commit them.
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
