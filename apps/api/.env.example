# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
# API port (the web reads NEXT_PUBLIC_API_URL to find it)
PORT=4010
# Local Postgres from the root docker-compose.yml (host port 5442)
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/prime_crm?schema=public
# Direct (non-pooled) Neon connection for migrations; Vercel/Neon set it. Not needed locally.
# DATABASE_URL_UNPOOLED=
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3010
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Shared secret Vercel crons send (Authorization: Bearer). Optional locally, required in production.
# Generate like JWT_SECRET; at least 16 characters.
CRON_SECRET=
# First admin, created by `npm run db:seed -w @prime-crm/api` if missing (never reset by a re-seed).
# Placeholders: set your own locally, never commit real values.
SEED_ADMIN_EMAIL=admin@prime.test
SEED_ADMIN_PASSWORD=change-me-at-least-8-chars
SEED_ADMIN_NAME=Admin
# Sample data (prisma/seed-sample.ts) runs after the foundation seed only when
# SEED_ALLOW_SAMPLE=true, and refuses NODE_ENV=production. Local and preview only.
# Its accounts (admin@prime.test, sara@prime.test, omar@prime.test, layla@prime.test,
# karim@prime.test) sign in with SEED_ADMIN_PASSWORD (admin) and SEED_MEMBER_PASSWORD (the rest).
SEED_ALLOW_SAMPLE=true
SEED_MEMBER_PASSWORD=change-me-at-least-8-chars
# Vercel Blob (listing photos). `vercel blob create-store <name> --access private` sets the token
# on Vercel. Unset locally = photo uploads answer 503 UPLOADS_NOT_CONFIGURED.
BLOB_READ_WRITE_TOKEN=
# Optional: the store's host (<store id>.private.blob.vercel-storage.com). A registered photo URL
# must be on it; unset = derived from the token's store id.
BLOB_STORE_HOST=
